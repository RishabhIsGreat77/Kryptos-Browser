<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/txt_suggestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/kryptos_text_primary"
        android:textSize="16sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Arrow Icon for Quick Paste -->
    <ImageView
        android:id="@+id/btn_arrow_paste"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_send"
        android:tint="@color/kryptos_text_secondary"
        android:rotation="45" /> <!-- Rotated to point top-left -->
</LinearLayout>
