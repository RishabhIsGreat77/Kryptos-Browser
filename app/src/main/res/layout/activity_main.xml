<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/kryptos_background">

    <!-- TOP BAR (Everything in one line) -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="8dp" android:layout_marginTop="8dp">

        <!-- Address Bar (Inline Editable) -->
        <LinearLayout
            android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:background="@drawable/bg_address_bar_pill"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <EditText
                android:id="@+id/address_bar"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:text="kryptos://home"
                android:textColor="@color/kryptos_text_primary" android:textSize="14sp"
                android:background="@android:color/transparent"
                android:imeOptions="actionGo" android:inputType="textUri"
                android:maxLines="1" android:selectAllOnFocus="true" />

            <ImageButton
                android:id="@+id/btn_reload"
                android:layout_width="28dp" android:layout_height="28dp"
                android:src="@drawable/ic_reload"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/kryptos_text_secondary"
                android:contentDescription="Reload" />
        </LinearLayout>

        <!-- Compact Icons: Back, Forward, Home, Tabs -->
        <ImageButton android:id="@+id/btn_back" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless" android:tint="@color/kryptos_icon_tint" android:padding="6dp" />
        <ImageButton android:id="@+id/btn_forward" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_forward" android:background="?attr/selectableItemBackgroundBorderless" android:tint="@color/kryptos_icon_tint" android:padding="6dp" />
        <ImageButton android:id="@+id/btn_home" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_home" android:background="?attr/selectableItemBackgroundBorderless" android:tint="@color/kryptos_icon_tint" android:padding="6dp" />
        
        <!-- Tabs Icon (Shows V3 Toast) -->
        <ImageButton android:id="@+id/btn_tabs" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_tabs" android:background="?attr/selectableItemBackgroundBorderless" android:tint="@color/kryptos_icon_tint" android:padding="6dp" />

        <!-- Settings Icon (Replaced Shield) -->
        <ImageButton android:id="@+id/btn_settings" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_menu_preferences" android:background="?attr/selectableItemBackgroundBorderless" android:tint="@color/kryptos_icon_tint" android:padding="6dp" />

    </LinearLayout>

    <!-- PROGRESS BAR -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="2dp"
        android:max="100" android:progress="0"
        android:progressTint="@color/kryptos_accent" android:visibility="gone" />

    <!-- MAIN CONTENT -->
    <FrameLayout
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        
        <WebView 
            android:id="@+id/webview" 
            android:layout_width="match_parent" 
            android:layout_height="match_parent" />
            
        <FrameLayout 
            android:id="@+id/homepage_container" 
            android:layout_width="match_parent" 
            android:layout_height="match_parent" 
            android:visibility="visible">
            <include layout="@layout/layout_homepage" />
        </FrameLayout>
        
        <FrameLayout 
            android:id="@+id/error_container" 
            android:layout_width="match_parent" 
            android:layout_height="match_parent" 
            android:visibility="gone">
            <include layout="@layout/layout_error_page" />
        </FrameLayout>
    </FrameLayout>

</LinearLayout>
