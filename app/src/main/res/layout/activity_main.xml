<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/kryptos_background">

    <!-- ===== TOP TOOLBAR (Sci-Fi Minimal) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_sm"
        android:background="@color/kryptos_background">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/nav_icon_touch_size"
            android:layout_height="@dimen/nav_icon_touch_size"
            android:src="@drawable/ic_back"
            android:padding="@dimen/nav_icon_padding"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_back" />

        <ImageButton
            android:id="@+id/btn_forward"
            android:layout_width="@dimen/nav_icon_touch_size"
            android:layout_height="@dimen/nav_icon_touch_size"
            android:src="@drawable/ic_forward"
            android:padding="@dimen/nav_icon_padding"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_forward" />

        <!-- Address Bar: Now gets full width -->
        <EditText
            android:id="@+id/address_bar"
            android:layout_width="0dp"
            android:layout_height="@dimen/address_bar_height"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/space_xs"
            android:background="@drawable/bg_homepage_search"
            android:hint="@string/address_bar_hint"
            android:textColorHint="@color/kryptos_address_bar_hint"
            android:textColor="@color/kryptos_address_bar_text"
            android:textSize="@dimen/address_bar_text_size"
            android:paddingHorizontal="@dimen/space_md"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:singleLine="true"
            android:contentDescription="@string/address_bar_description" />

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="@dimen/nav_icon_touch_size"
            android:layout_height="@dimen/nav_icon_touch_size"
            android:src="@drawable/ic_menu"
            android:padding="@dimen/nav_icon_padding"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_menu" />

    </LinearLayout>

    <!-- ===== Progress bar ===== -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/progress_bar_height"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/kryptos_accent"
        android:progressBackgroundTint="@android:color/transparent"
        android:visibility="gone" />

    <!-- ===== Content Area ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/homepage_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">
            <include layout="@layout/layout_homepage" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/error_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <include layout="@layout/layout_error_page" />
        </FrameLayout>

    </FrameLayout>

    <!-- ===== BOTTOM TOOLBAR (Sci-Fi Aesthetic) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/kryptos_surface"
        android:elevation="4dp">

        <!-- Search Engine Selector -->
        <ImageButton
            android:id="@+id/btn_search_engine"
            android:layout_width="@dimen/nav_icon_touch_size"
            android:layout_height="@dimen/nav_icon_touch_size"
            android:layout_marginHorizontal="@dimen/space_xl"
            android:src="@drawable/ic_search_engine"
            android:padding="@dimen/nav_icon_padding"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_engine_selector_desc" />

        <!-- Reload -->
        <ImageButton
            android:id="@+id/btn_reload"
            android:layout_width="@dimen/nav_icon_touch_size"
            android:layout_height="@dimen/nav_icon_touch_size"
            android:layout_marginHorizontal="@dimen/space_xl"
            android:src="@drawable/ic_reload"
            android:padding="@dimen/nav_icon_padding"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_reload" />

        <!-- Home -->
        <ImageButton
            android:id="@+id/btn_home"
            android:layout_width="@dimen/nav_icon_touch_size"
            android:layout_height="@dimen/nav_icon_touch_size"
            android:layout_marginHorizontal="@dimen/space_xl"
            android:src="@drawable/ic_home"
            android:padding="@dimen/nav_icon_padding"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_home" />

    </LinearLayout>

</LinearLayout>
