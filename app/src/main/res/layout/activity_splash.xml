<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kryptos_background">

    <!-- Naya Fingerprint Logo -->
    <ImageView
        android:id="@+id/splash_logo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_centerInParent="true"
        android:src="@drawable/ic_fingerprint"
        android:tint="@color/kryptos_primary" />

    <!-- App name -->
    <TextView
        android:id="@+id/splash_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/splash_logo"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:text="KRYPTOS"
        android:textColor="@color/kryptos_text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.2" />

    <!-- Small loading text at the bottom -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="48dp"
        android:text="SECURE BROWSING"
        android:textColor="@color/kryptos_primary"
        android:textSize="10sp"
        android:letterSpacing="0.3" />

</RelativeLayout>
