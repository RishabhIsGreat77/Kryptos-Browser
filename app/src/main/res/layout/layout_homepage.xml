<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/kryptos_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="100dp"
        android:gravity="center_horizontal">

        <!-- Fingerprint Logo (Green Glow) -->
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_fingerprint"
            android:tint="@color/kryptos_primary" />

        <!-- KRYPTOS Wordmark -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="KRYPTOS"
            android:textColor="@color/kryptos_text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="SECURE CONNECTION ACTIVE"
            android:textColor="@color/kryptos_primary"
            android:textSize="10sp"
            android:letterSpacing="0.1" />

        <!-- Speed Dial Grid (4 Items) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center">

            <!-- Item 1: GitHub -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_speed_dial_icon"
                    android:padding="16dp"
                    android:src="@drawable/ic_search_engine" 
                    android:tint="#FFFFFF" /> <!-- Yahan GitHub ka icon aayega baad me -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="GitHub"
                    android:textColor="@color/kryptos_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Item 2: Reddit -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_speed_dial_icon"
                    android:padding="16dp"
                    android:src="@drawable/ic_search_engine" 
                    android:tint="#FF4500" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Reddit"
                    android:textColor="@color/kryptos_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Item 3: YouTube -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_speed_dial_icon"
                    android:padding="16dp"
                    android:src="@drawable/ic_search_engine" 
                    android:tint="#FF0000" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="YouTube"
                    android:textColor="@color/kryptos_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Item 4: Add Button (Dashed) -->
            <LinearLayout
                android:id="@+id/btn_add_speed_dial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_add_dashed"
                    android:padding="16dp"
                    android:src="@android:drawable/ic_input_add"
                    android:tint="@color/kryptos_text_secondary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Add"
                    android:textColor="@color/kryptos_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Trackers Blocked Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trackers Blocked"
                    android:textColor="@color/kryptos_text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="bottom">
                    
                    <TextView
                        android:id="@+id/txt_tracker_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1,402"
                        android:textColor="@color/kryptos_text_primary"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="4dp"
                        android:text="+12 today"
                        android:textColor="@color/kryptos_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right Side Circular Shield -->
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_fire_glow">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_shield"
                    android:tint="@color/kryptos_text_secondary" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
