<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/kryptos_background">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="20dp"
        android:paddingTop="24dp" android:paddingBottom="40dp">

        <!-- ORBITAL ANIMATION CONTAINER -->
        <FrameLayout
            android:layout_width="160dp" android:layout_height="160dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="16dp">
            <ImageView
                android:id="@+id/logo_container"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/ic_kryptos_logo" />
            <View android:id="@+id/dot1" android:layout_width="8dp" android:layout_height="8dp" android:layout_gravity="center" android:background="@drawable/bg_dot" />
            <View android:id="@+id/dot2" android:layout_width="6dp" android:layout_height="6dp" android:layout_gravity="center" android:background="@drawable/bg_dot" />
            <View android:id="@+id/dot3" android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="center" android:background="@drawable/bg_dot" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:layout_marginTop="16dp"
            android:text="kryptos" android:textColor="@color/kryptos_text_primary"
            android:textSize="32sp" android:letterSpacing="0.05" />

        <!-- Search Bar with "X" Button -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="32dp" android:background="@drawable/bg_homepage_search"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingHorizontal="16dp">
            <ImageView
                android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_search_engine" android:tint="@color/kryptos_text_secondary" />
            <EditText
                android:id="@+id/homepage_search_input"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Search or type URL..."
                android:textColorHint="@color/kryptos_text_secondary"
                android:textColor="@color/kryptos_text_primary"
                android:textSize="15sp" android:imeOptions="actionGo" android:inputType="textUri" />
            <!-- NAYA: X BUTTON -->
            <ImageView
                android:id="@+id/btn_clear_input"
                android:layout_width="20dp" android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@color/kryptos_text_secondary"
                android:visibility="gone" /> <!-- शुरू में छिपा रहेगा -->
        </LinearLayout>

        <!-- NAYA: SEARCH SUGGESTIONS VIEW -->
        <TextView
            android:id="@+id/txt_suggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="@drawable/bg_card"
            android:text="Trending: Weather today"
            android:textColor="@color/kryptos_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Engine Switcher -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView
                android:id="@+id/txt_current_engine"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Engine: Google"
                android:textColor="@color/kryptos_text_secondary" android:textSize="12sp" />
            <TextView
                android:id="@+id/btn_switch_engine"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Switch" android:textColor="@color/kryptos_text_primary"
                android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
