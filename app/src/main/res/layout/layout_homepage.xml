<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/kryptos_background"
    android:padding="@dimen/space_xl">

    <!-- Naya PNG Logo -->
    <ImageView
        android:id="@+id/homepage_logo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/kryptos_logo"
        android:contentDescription="@string/app_name" />

    <!-- App Name: Sci-Fi style with letter spacing -->
    <TextView
        android:id="@+id/homepage_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/app_name"
        android:textColor="@color/kryptos_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:textAllCaps="true" />

    <!-- Tagline -->
    <TextView
        android:id="@+id/homepage_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/homepage_tagline"
        android:textColor="@color/kryptos_text_secondary"
        android:textSize="14sp"
        android:letterSpacing="0.05" />

    <!-- Search Box -->
    <EditText
        android:id="@+id/homepage_search_input"
        android:layout_width="match_parent"
        android:layout_height="@dimen/homepage_search_height"
        android:layout_marginTop="@dimen/space_xxl"
        android:layout_marginHorizontal="@dimen/space_md"
        android:background="@drawable/bg_homepage_search"
        android:hint="@string/homepage_search_hint"
        android:textColorHint="@color/kryptos_address_bar_hint"
        android:textColor="@color/kryptos_address_bar_text"
        android:textSize="@dimen/address_bar_text_size"
        android:paddingHorizontal="@dimen/space_lg"
        android:imeOptions="actionGo"
        android:inputType="textUri"
        android:maxLines="1"
        android:singleLine="true" />

</LinearLayout>
