<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/kryptos_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="40dp"
        android:gravity="center_horizontal">

        <!-- Fingerprint Logo -->
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_fingerprint" />

        <!-- KRYPTOS Wordmark -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="KRYPTOS"
            android:textColor="@color/kryptos_text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="SECURE CONNECTION ACTIVE"
            android:textColor="@color/kryptos_primary"
            android:textSize="10sp"
            android:letterSpacing="0.1" />

        <!-- Speed Dial Grid (4 Items) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center">

            <!-- Item 1: GitHub -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:src="@drawable/ic_search_engine"
                    android:tint="@color/kryptos_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="GitHub"
                    android:textColor="@color/kryptos_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Item 2: Reddit -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:src="@drawable/ic_search_engine"
                    android:tint="@color/kryptos_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Reddit"
                    android:textColor="@color/kryptos_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Item 3: YouTube -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:src="@drawable/ic_search_engine"
                    android:tint="@color/kryptos_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="YouTube"
                    android:textColor="@color/kryptos_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Item 4: Add Button -->
            <LinearLayout
                android:id="@+id/btn_add_speed_dial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:src="@android:drawable/ic_input_add"
                    android:tint="@color/kryptos_text_secondary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Add"
                    android:textColor="@color/kryptos_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Trackers Blocked Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trackers Blocked"
                    android:textColor="@color/kryptos_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txt_tracker_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="1,402"
                    android:textColor="@color/kryptos_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Simple Icon (Can be replaced with Circular Progress later) -->
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_shield"
                android:tint="@color/kryptos_primary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
