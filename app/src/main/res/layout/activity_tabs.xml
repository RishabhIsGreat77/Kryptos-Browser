<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kryptos_background">

    <LinearLayout
        android:id="@+id/tabs_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tabs"
            android:textColor="@color/kryptos_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Incognito Tab Button -->
        <ImageButton
            android:id="@+id/btn_new_incognito_tab"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_shield"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/kryptos_primary" 
            android:layout_marginEnd="8dp"/>

        <!-- New Tab (+) Button -->
        <ImageButton
            android:id="@+id/btn_new_tab"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_input_add"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/kryptos_text_primary" />
    </LinearLayout>

    <!-- NEW: Tab Mode Selector (Normal vs Incognito) -->
    <LinearLayout
        android:id="@+id/tab_selector_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tabs_top_bar"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btn_tab_normal"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Normal Tabs"
            android:gravity="center"
            android:textColor="@color/kryptos_text_primary"
            android:textStyle="bold"
            android:background="@drawable/bg_speed_dial_box"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/btn_tab_incognito"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Incognito Tabs"
            android:gravity="center"
            android:textColor="@color/kryptos_text_secondary"
            android:background="@android:color/transparent" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tabs_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tab_selector_layout"
        android:padding="8dp"
        android:clipToPadding="false" />

</RelativeLayout>
