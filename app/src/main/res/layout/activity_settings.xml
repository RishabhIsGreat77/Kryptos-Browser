<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/kryptos_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/kryptos_text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- Search Suggestions Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Search Suggestions"
                android:textColor="@color/kryptos_text_primary"
                android:textSize="16sp"/>
            <Switch
                android:id="@+id/switch_suggestions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Dark Mode Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dark Mode"
                android:textColor="@color/kryptos_text_primary"
                android:textSize="16sp"/>
            <Switch
                android:id="@+id/switch_dark_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- NAYA SECTION: SECURITY & PRIVACY -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Security &amp; Privacy"
            android:textColor="@color/kryptos_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <!-- Incognito Auto-Kill Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Incognito Auto-Kill"
                    android:textColor="@color/kryptos_text_primary"
                    android:textSize="16sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kill app and clear data when screen locks"
                    android:textColor="@color/kryptos_text_secondary"
                    android:textSize="12sp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/switch_incognito_kill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Panic Shake Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Panic Shake"
                    android:textColor="@color/kryptos_text_primary"
                    android:textSize="16sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shake phone to instantly close browser"
                    android:textColor="@color/kryptos_text_secondary"
                    android:textSize="12sp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/switch_panic_shake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Ghost Vault Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ghost Vault"
                    android:textColor="@color/kryptos_text_primary"
                    android:textSize="16sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hide history behind a secret kryptos:// command"
                    android:textColor="@color/kryptos_text_secondary"
                    android:textSize="12sp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/switch_ghost_vault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Clear Data Option -->
        <TextView
            android:id="@+id/txt_clear_data_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear Browsing Data"
            android:textColor="@color/kryptos_text_secondary"
            android:textSize="16sp"
            android:paddingVertical="16dp"
            android:layout_marginTop="16dp"/>

        <!-- Check for Updates Option -->
        <TextView
            android:id="@+id/txt_check_updates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check for Updates"
            android:textColor="@color/kryptos_text_secondary"
            android:textSize="16sp"
            android:paddingVertical="16dp"/>

    </LinearLayout>
</ScrollView>
