<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="8dp" android:background="@drawable/bg_card"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/bm_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Title" android:textColor="@color/kryptos_text_primary" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/bm_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="URL" android:textColor="@color/kryptos_text_secondary" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
