<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kryptos_background">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/history_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="History"
            android:textColor="@color/kryptos_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_clear_all_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear All"
            android:textColor="@color/kryptos_error"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="8dp" />
    </LinearLayout>

    <!-- RecyclerView for History List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/history_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/history_top_bar"
        android:padding="12dp"
        android:clipToPadding="false" />

    <!-- Empty State (Jab history khali ho) -->
    <TextView
        android:id="@+id/txt_empty_history"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="No history yet."
        android:textColor="@color/kryptos_text_secondary"
        android:textSize="16sp"
        android:visibility="gone" />

</RelativeLayout>
