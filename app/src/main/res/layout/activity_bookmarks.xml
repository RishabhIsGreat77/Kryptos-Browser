<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/kryptos_background">

    <LinearLayout android:id="@+id/bookmarks_top_bar" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bookmarks" android:textColor="@color/kryptos_text_primary" android:textSize="22sp" android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/bookmarks_recycler_view" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/bookmarks_top_bar" android:padding="12dp" />
</RelativeLayout>
