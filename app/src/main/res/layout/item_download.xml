<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/stat_sys_download_done"
        android:tint="@color/kryptos_primary"
        android:layout_marginEnd="16dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dl_filename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/kryptos_text_primary"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Filename.apk" />

        <TextView
            android:id="@+id/dl_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/kryptos_text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:text="Downloaded" />
    </LinearLayout>
</LinearLayout>
