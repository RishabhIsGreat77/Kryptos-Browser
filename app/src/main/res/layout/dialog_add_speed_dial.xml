<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add to Speed Dial"
        android:textColor="@color/kryptos_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_sd_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_address_bar_pill"
        android:hint="Website Name (e.g. Amazon)"
        android:padding="12dp"
        android:textColor="@color/kryptos_text_primary"
        android:textColorHint="@color/kryptos_text_secondary"
        android:inputType="text" />

    <EditText
        android:id="@+id/et_sd_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_address_bar_pill"
        android:hint="URL (e.g. amazon.in)"
        android:padding="12dp"
        android:textColor="@color/kryptos_text_primary"
        android:textColorHint="@color/kryptos_text_secondary"
        android:inputType="textUri" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_cancel_sd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Cancel"
            android:textColor="@color/kryptos_text_secondary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_save_sd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:padding="8dp"
            android:text="Save"
            android:textColor="@color/kryptos_primary"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
