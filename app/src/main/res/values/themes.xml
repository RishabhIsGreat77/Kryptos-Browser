<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- App ki main theme -->
    <style name="Theme.KryptosBrowser" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/kryptos_primary</item>
        <item name="colorPrimaryDark">@color/kryptos_primary_dark</item>
        <item name="colorAccent">@color/kryptos_accent</item>
        <item name="android:windowBackground">@color/kryptos_background</item>
        <item name="android:statusBarColor">@color/kryptos_background</item>
        <item name="android:navigationBarColor">@color/kryptos_background</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- NAYA: Popup Menu ko Dark theme me convert karne ke liye -->
        <item name="popupMenuStyle">@style/PopupMenu.Kryptos</item>
        <item name="android:itemBackground">@color/kryptos_surface</item>
        <item name="android:textColor">@color/kryptos_text_primary</item>
    </style>

    <!-- Popup Menu ki styling -->
    <style name="PopupMenu.Kryptos" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@color/kryptos_surface</item>
        <item name="android:textColor">@color/kryptos_text_primary</item>
    </style>

</resources>
